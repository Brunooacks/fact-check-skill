# ─────────────────────────────────────────────────────────────
# LLM (LangChain) — Claude por padrão
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# Sem ANTHROPIC_API_KEY os agentes rodam em modo STUB (determinístico),
# o que permite testar identidade + governança sem gastar tokens.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Governança / Identidade — genérico, plugável em qualquer plataforma
# ─────────────────────────────────────────────────────────────
# URL base da plataforma de governança que você vai testar.
# Se vazio, os agentes gravam auditoria apenas localmente (./audit/*.jsonl).
GOVERNANCE_URL=
# Credencial de identidade do agente perante a plataforma (Bearer).
AGENT_CREDENTIAL=
# strict=true faz o agente ABORTAR se a plataforma recusar registro/policy.
GOVERNANCE_STRICT=false
# Diretório onde a trilha de auditoria local é gravada.
AUDIT_DIR=/data/audit

# Sobrescreve o agent_id do manifesto (por padrão é derivado do nome, estável).
# AGENT_ID=
